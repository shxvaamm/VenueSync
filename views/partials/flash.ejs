<% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length > 0) { %>
  <div class="flash-container">
    <% (Array.isArray(success_msg) ? success_msg : [success_msg]).forEach(function(msg) { %>
      <div class="alert alert-success" role="alert">
        <div class="alert-content">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
          <span><%= msg %></span>
        </div>
        <button type="button" class="alert-close" onclick="this.parentElement.remove()" aria-label="Dismiss alert">&times;</button>
      </div>
    <% }); %>
  </div>
<% } %>

