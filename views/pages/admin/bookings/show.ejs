<div class="container" style="padding-top: var(--space-8); padding-bottom: var(--space-16); max-width: 900px;">
  <div style="margin-bottom: var(--space-6); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--space-4);">
    <div>
      <a href="/admin/bookings" class="btn btn-secondary btn-sm" style="margin-bottom: var(--space-2);">&larr; Back to all bookings</a>
      <h1 style="margin-bottom: var(--space-1);"><%= booking.eventName %></h1>
      <span style="font-family: monospace; font-size: var(--text-sm); color: var(--text-soft);">
        Reference ID: #<%= booking._id.toString().toUpperCase() %>
      </span>
    </div>
    <div>
      <span class="badge badge-<%= booking.status %>" style="font-size: var(--text-sm); padding: 0.5rem 1rem;">
        Status: <%= booking.status %>
      </span>
    </div>
  </div>

  <!-- Warning Banner for Approved Bookings with Conflicting Pending Requests (Requirement 5) -->
  <% if (booking.status === 'approved' && overlappingPending && overlappingPending.length > 0) { %>
    <div class="alert alert-warning" style="display: block; margin-bottom: var(--space-6);">
      <div style="display: flex; align-items: flex-start; gap: var(--space-3); margin-bottom: var(--space-3);">
        <span style="font-size: var(--text-xl); line-height: 1;">&#9888;</span>
        <div>
          <strong style="font-size: var(--text-base); display: block;">Overlapping Pending Requests Detected!</strong>
          <span style="font-size: var(--text-sm);">
            This approved booking occupies a time slot that clashes with <strong><%= overlappingPending.length %></strong> other pending request(s) for <strong><%= booking.venue ? booking.venue.name : 'this venue' %></strong>. These requests can no longer be approved without conflict.
          </span>
        </div>
      </div>

      <div style="background-color: rgba(255, 255, 255, 0.7); border-radius: var(--radius-md); padding: var(--space-3); margin-top: var(--space-3);">
        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--space-3);">
          <% overlappingPending.forEach(function(item) { %>
            <li style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--space-3); padding-bottom: var(--space-2); border-bottom: 1px solid rgba(0, 0, 0, 0.08);">
              <div>
                <strong><%= item.eventName %></strong> &mdash; 
                <span><%= item.organiser ? (item.organiser.name || item.organiser.email) : 'Organiser' %></span>
                <span style="display: block; font-size: var(--text-xs); color: var(--text-muted);">
                  Slot: <%= formatISTSlot(item.start, item.end) %>
                </span>
              </div>
              <div style="display: flex; gap: var(--space-2); align-items: center;">
                <a href="/admin/bookings/<%= item._id %>" class="btn btn-secondary btn-sm" style="font-size: var(--text-xs);">View</a>
                <form action="/admin/bookings/<%= item._id %>/reject" method="POST" style="display: inline;">
                  <input type="hidden" name="decisionNote" value="Rejected due to conflict with approved booking: <%= booking.eventName %>">
                  <input type="hidden" name="returnUrl" value="/admin/bookings/<%= booking._id %>">
                  <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Decline this conflicting request?');">
                    Quick Reject
                  </button>
                </form>
              </div>
            </li>
          <% }); %>
        </ul>
      </div>
    </div>
  <% } %>

  <!-- Booking Details Grid -->
  <div class="card" style="margin-bottom: var(--space-8);">
    <div class="card-header">
      <h3 style="font-size: var(--text-base); margin: 0;">Reservation Overview</h3>
    </div>
    <div class="card-body" style="padding: var(--space-6);">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: var(--space-6);">
        <!-- Venue Info -->
        <div>
          <span style="font-size: var(--text-xs); font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Venue</span>
          <p style="font-size: var(--text-base); font-weight: 600; margin-top: var(--space-1); margin-bottom: var(--space-1);">
            <% if (booking.venue) { %>
              <a href="/venues/<%= booking.venue._id %>" target="_blank"><%= booking.venue.name %></a>
            <% } else { %>
              <span class="text-muted">Unspecified Venue</span>
            <% } %>
          </p>
          <% if (booking.venue) { %>
            <span style="font-size: var(--text-xs); color: var(--text-muted);">
              Capacity: <%= booking.venue.capacity %> seats &bull; Rate: ₹<%= booking.venue.hourlyRate %>/hr
            </span>
          <% } %>
        </div>

        <!-- Organiser Info -->
        <div>
          <span style="font-size: var(--text-xs); font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Organiser</span>
          <p style="font-size: var(--text-base); font-weight: 600; margin-top: var(--space-1); margin-bottom: var(--space-1);">
            <%= booking.organiser ? (booking.organiser.name || 'Unnamed Organiser') : 'Unknown' %>
          </p>
          <% if (booking.organiser && booking.organiser.email) { %>
            <span style="font-size: var(--text-xs); color: var(--text-muted);">
              Email: <a href="mailto:<%= booking.organiser.email %>"><%= booking.organiser.email %></a>
            </span>
          <% } %>
        </div>

        <!-- Time Slot Info -->
        <div>
          <span style="font-size: var(--text-xs); font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Time Slot (IST)</span>
          <p style="font-size: var(--text-base); font-weight: 600; margin-top: var(--space-1); margin-bottom: var(--space-1);">
            <%= formatISTSlot(booking.start, booking.end) %>
          </p>
          <span style="font-size: var(--text-xs); color: var(--text-muted);">
            Submission Date: <%= formatISTDateTime(booking.createdAt) %>
          </span>
        </div>

        <!-- Attendees & Cost -->
        <div>
          <span style="font-size: var(--text-xs); font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Capacity & Total Cost</span>
          <p style="font-size: var(--text-base); font-weight: 600; margin-top: var(--space-1); margin-bottom: var(--space-1);">
            <%= booking.attendees %> Attendees &bull; ₹<%= booking.totalCost %>
          </p>
          <span style="font-size: var(--text-xs); color: var(--text-muted);">
            Calculated from venue hourly rate and reservation duration
          </span>
        </div>
      </div>

      <!-- Description if present -->
      <% if (booking.description) { %>
        <div style="margin-top: var(--space-6); padding-top: var(--space-4); border-top: 1px solid var(--border-light);">
          <span style="font-size: var(--text-xs); font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Event Description</span>
          <p style="margin-top: var(--space-2); margin-bottom: 0; color: var(--text-main); font-size: var(--text-sm); line-height: 1.6;">
            <%= booking.description %>
          </p>
        </div>
      <% } %>

      <!-- Decision Note if present -->
      <% if (booking.decisionNote) { %>
        <div style="margin-top: var(--space-6); padding-top: var(--space-4); border-top: 1px solid var(--border-light);">
          <span style="font-size: var(--text-xs); font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Decision / Administrator Note</span>
          <div style="margin-top: var(--space-2); padding: var(--space-3); background-color: var(--bg-surface-alt); border-radius: var(--radius-md); font-size: var(--text-sm);">
            <%= booking.decisionNote %>
          </div>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Status Transition Controls -->
  <div class="card">
    <div class="card-header">
      <h3 style="font-size: var(--text-base); margin: 0;">Available Actions</h3>
    </div>
    <div class="card-body" style="padding: var(--space-6);">
      
      <!-- State 1: PENDING -->
      <% if (booking.status === 'pending') { %>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-6);">
          <!-- Approve Form -->
          <div style="padding: var(--space-5); border: 1px solid #a7f3d0; background-color: #ecfdf5; border-radius: var(--radius-lg);">
            <h4 style="color: #065f46; margin-top: 0; margin-bottom: var(--space-2);">Approve Booking</h4>
            <p style="font-size: var(--text-xs); color: #047857; margin-bottom: var(--space-4);">
              Confirms this reservation slot. The system will re-check venue availability and flag any overlapping pending requests.
            </p>
            <form action="/admin/bookings/<%= booking._id %>/approve" method="POST">
              <div class="form-group">
                <label for="approveDecisionNote" class="form-label" style="font-size: var(--text-xs); color: #065f46;">Approval Note (Optional)</label>
                <input type="text" name="decisionNote" id="approveDecisionNote" class="form-control" placeholder="e.g. Approved. Key handoff at security desk.">
              </div>
              <button type="submit" class="btn btn-success" style="width: 100%;">
                Approve booking
              </button>
            </form>
          </div>

          <!-- Reject Form -->
          <div style="padding: var(--space-5); border: 1px solid #fecdd3; background-color: #fff1f2; border-radius: var(--radius-lg);">
            <h4 style="color: #9f1239; margin-top: 0; margin-bottom: var(--space-2);">Reject Booking</h4>
            <p style="font-size: var(--text-xs); color: #be123c; margin-bottom: var(--space-4);">
              Declines this request. Rejection is a permanent terminal state and cannot be undone.
            </p>
            <form action="/admin/bookings/<%= booking._id %>/reject" method="POST">
              <div class="form-group">
                <label for="rejectDecisionNote" class="form-label" style="font-size: var(--text-xs); color: #9f1239;">Rejection Reason (Optional)</label>
                <input type="text" name="decisionNote" id="rejectDecisionNote" class="form-control" placeholder="e.g. Venue required for academic examination.">
              </div>
              <button type="submit" class="btn btn-danger" style="width: 100%;" onclick="return confirm('Are you sure you want to permanently reject this booking request?');">
                Reject booking
              </button>
            </form>
          </div>
        </div>

      <!-- State 2: APPROVED -->
      <% } else if (booking.status === 'approved') { %>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-6);">
          <!-- Complete Form -->
          <div style="padding: var(--space-5); border: 1px solid #c7d2fe; background-color: #eef2ff; border-radius: var(--radius-lg);">
            <h4 style="color: #3730a3; margin-top: 0; margin-bottom: var(--space-2);">Mark as Completed</h4>
            <p style="font-size: var(--text-xs); color: #4338ca; margin-bottom: var(--space-3);">
              Transition this reservation to completed after the event has concluded.
            </p>
            
            <% if (isPastEvent) { %>
              <form action="/admin/bookings/<%= booking._id %>/complete" method="POST">
                <div class="form-group">
                  <label for="completeDecisionNote" class="form-label" style="font-size: var(--text-xs); color: #3730a3;">Closing Note (Optional)</label>
                  <input type="text" name="decisionNote" id="completeDecisionNote" class="form-control" placeholder="e.g. Venue inspected, event completed smoothly.">
                </div>
                <button type="submit" class="btn btn-primary" style="width: 100%;">
                  Mark completed
                </button>
              </form>
            <% } else { %>
              <div class="alert alert-info" style="font-size: var(--text-xs); margin-bottom: var(--space-3);">
                Event has not yet concluded. "Completed" status is only permitted after <strong><%= formatISTDateTime(booking.end) %> IST</strong>.
              </div>
              <button class="btn btn-secondary" style="width: 100%; opacity: 0.6; cursor: not-allowed;" disabled title="Completion restricted until after event end time">
                Mark completed (Event pending)
              </button>
            <% } %>
          </div>

          <!-- Cancel Form -->
          <div style="padding: var(--space-5); border: 1px solid #fecdd3; background-color: #fff1f2; border-radius: var(--radius-lg);">
            <h4 style="color: #9f1239; margin-top: 0; margin-bottom: var(--space-2);">Cancel Approved Booking</h4>
            <p style="font-size: var(--text-xs); color: #be123c; margin-bottom: var(--space-4);">
              Revokes this approved booking and frees the slot for other organisers.
            </p>
            <form action="/admin/bookings/<%= booking._id %>/cancel" method="POST">
              <div class="form-group">
                <label for="cancelDecisionNote" class="form-label" style="font-size: var(--text-xs); color: #9f1239;">Cancellation Reason (Optional)</label>
                <input type="text" name="decisionNote" id="cancelDecisionNote" class="form-control" placeholder="e.g. Cancelled due to maintenance emergency.">
              </div>
              <button type="submit" class="btn btn-danger" style="width: 100%;" onclick="return confirm('Are you sure you want to cancel this approved booking? This action is permanent.');">
                Cancel booking
              </button>
            </form>
          </div>
        </div>

      <!-- State 3: FINAL STATES (rejected, completed, cancelled) -->
      <% } else { %>
        <div style="text-align: center; padding: var(--space-6); background-color: var(--bg-surface-alt); border-radius: var(--radius-md);">
          <span class="badge badge-<%= booking.status %>" style="font-size: var(--text-sm); margin-bottom: var(--space-2);">
            Terminal State: <%= booking.status %>
          </span>
          <p style="color: var(--text-muted); font-size: var(--text-sm); margin: 0;">
            This booking is in a final state (<%= booking.status %>). In accordance with server transition policies, final states cannot be altered.
          </p>
        </div>
      <% } %>

    </div>
  </div>
</div>
