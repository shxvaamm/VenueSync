<div class="container" style="padding-top: var(--space-8); padding-bottom: var(--space-16);">
  <div style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: var(--space-4); margin-bottom: var(--space-8);">
    <div>
      <span class="hero-pill" style="margin-bottom: var(--space-2);">&#9679; Venue Manager Console</span>
      <h1 style="margin-bottom: var(--space-2);">Campus Booking Approvals</h1>
      <p style="margin: 0; color: var(--text-muted);">
        Audit, approve, and manage venue reservations across campus facilities.
      </p>
    </div>
    <div style="display: flex; gap: var(--space-3); align-items: center; flex-wrap: wrap;">
      <% if (pendingCount > 0) { %>
        <span class="badge badge-pending" style="font-size: var(--text-sm); padding: 0.5rem 0.85rem;">
          <%= pendingCount %> pending request<%= pendingCount === 1 ? '' : 's' %> requiring review
        </span>
      <% } else { %>
        <span class="badge badge-approved" style="font-size: var(--text-sm); padding: 0.5rem 0.85rem;">
          All requests reviewed
        </span>
      <% } %>
      <a href="/admin/dashboard" class="btn btn-secondary btn-sm">Admin Dashboard</a>
    </div>
  </div>

  <!-- Filters Card -->
  <div class="card" style="margin-bottom: var(--space-6); background-color: var(--bg-surface);">
    <div class="card-body" style="padding: var(--space-6);">
      <form action="/admin/bookings" method="GET">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--space-4); align-items: flex-end;">
          <!-- Status Filter -->
          <div class="form-group" style="margin-bottom: 0;">
            <label for="status" class="form-label" style="font-size: var(--text-xs); text-transform: uppercase;">Status</label>
            <select name="status" id="status" class="form-control form-select">
              <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>All Statuses</option>
              <option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>>Pending Review</option>
              <option value="approved" <%= filters.status === 'approved' ? 'selected' : '' %>>Approved</option>
              <option value="rejected" <%= filters.status === 'rejected' ? 'selected' : '' %>>Rejected</option>
              <option value="completed" <%= filters.status === 'completed' ? 'selected' : '' %>>Completed</option>
              <option value="cancelled" <%= filters.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
            </select>
          </div>

          <!-- Venue Filter -->
          <div class="form-group" style="margin-bottom: 0;">
            <label for="venue" class="form-label" style="font-size: var(--text-xs); text-transform: uppercase;">Venue</label>
            <select name="venue" id="venue" class="form-control form-select">
              <option value="all" <%= filters.venue === 'all' ? 'selected' : '' %>>All Venues</option>
              <% venues.forEach(function(v) { %>
                <option value="<%= v._id %>" <%= filters.venue === v._id.toString() ? 'selected' : '' %>>
                  <%= v.name %>
                </option>
              <% }); %>
            </select>
          </div>

          <!-- Date Range: From -->
          <div class="form-group" style="margin-bottom: 0;">
            <label for="fromDate" class="form-label" style="font-size: var(--text-xs); text-transform: uppercase;">From Date (IST)</label>
            <input type="date" name="fromDate" id="fromDate" class="form-control" value="<%= filters.fromDate %>">
          </div>

          <!-- Date Range: To -->
          <div class="form-group" style="margin-bottom: 0;">
            <label for="toDate" class="form-label" style="font-size: var(--text-xs); text-transform: uppercase;">To Date (IST)</label>
            <input type="date" name="toDate" id="toDate" class="form-control" value="<%= filters.toDate %>">
          </div>

          <!-- Actions -->
          <div style="display: flex; gap: var(--space-2);">
            <button type="submit" class="btn btn-primary" style="flex: 1;">Filter</button>
            <a href="/admin/bookings" class="btn btn-secondary" title="Reset Filters">Reset</a>
          </div>
        </div>
      </form>
    </div>
  </div>

  <!-- Bookings List Table -->
  <div class="card">
    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--space-2);">
      <h3 style="font-size: var(--text-base); margin: 0;">
        Reservation Submissions (<%= pagination.totalBookings %> total)
      </h3>
      <% if (filters.status !== 'all' || filters.venue !== 'all' || filters.fromDate || filters.toDate) { %>
        <span style="font-size: var(--text-xs); color: var(--text-muted);">
          Filtered by: 
          <%= filters.status !== 'all' ? `Status: ${filters.status}; ` : '' %>
          <%= filters.venue !== 'all' ? `Venue: selected; ` : '' %>
          <%= filters.fromDate ? `From: ${filters.fromDate}; ` : '' %>
          <%= filters.toDate ? `To: ${filters.toDate}; ` : '' %>
          <a href="/admin/bookings" style="text-decoration: underline;">Clear</a>
        </span>
      <% } %>
    </div>
    <div class="table-container">
      <table class="table table-hover">
        <thead>
          <tr>
            <th>Event & Organiser</th>
            <th>Venue</th>
            <th>Time Slot (IST)</th>
            <th>Attendees</th>
            <th>Total Cost</th>
            <th>Status</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (bookings && bookings.length > 0) { %>
            <% bookings.forEach(function(b) { %>
              <tr class="<%= b.status === 'pending' ? 'table-row-pending' : '' %>" style="<%= b.status === 'pending' ? 'background-color: rgba(245, 158, 11, 0.07); border-left: 4px solid #d97706;' : '' %>">
                <td>
                  <strong><%= b.eventName %></strong>
                  <span style="display: block; font-family: monospace; font-size: var(--text-xs); color: var(--text-soft);">
                    #<%= b._id.toString().slice(-6).toUpperCase() %>
                  </span>
                  <span style="display: block; font-size: var(--text-xs); color: var(--text-muted); margin-top: var(--space-1);">
                    Organiser: <strong><%= b.organiser ? (b.organiser.name || b.organiser.email) : 'Unknown' %></strong>
                    <% if (b.organiser && b.organiser.email) { %>
                      (<%= b.organiser.email %>)
                    <% } %>
                  </span>
                </td>
                <td>
                  <% if (b.venue) { %>
                    <strong><%= b.venue.name %></strong>
                    <span style="display: block; font-size: var(--text-xs); color: var(--text-muted);">
                      Rate: ₹<%= b.venue.hourlyRate %>/hr
                    </span>
                  <% } else { %>
                    <span class="text-muted">Unspecified Venue</span>
                  <% } %>
                </td>
                <td>
                  <strong><%= formatISTSlot(b.start, b.end) %></strong>
                  <span style="display: block; font-size: var(--text-xs); color: var(--text-soft);">
                    Submitted: <%= formatISTDateTime(b.createdAt) %>
                  </span>
                </td>
                <td><%= b.attendees %> seats</td>
                <td><strong>₹<%= b.totalCost %></strong></td>
                <td>
                  <span class="badge badge-<%= b.status %>">
                    <%= b.status %>
                  </span>
                  <% if (b.status === 'pending') { %>
                    <span style="display: block; font-size: var(--text-xs); font-weight: 700; color: #b45309; margin-top: var(--space-1);">
                      &#9888; Action needed
                    </span>
                  <% } %>
                  <% if (b.decisionNote) { %>
                    <span style="display: block; font-size: var(--text-xs); color: var(--text-muted); margin-top: var(--space-1); max-width: 180px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="<%= b.decisionNote %>">
                      Note: <%= b.decisionNote %>
                    </span>
                  <% } %>
                </td>
                <td>
                  <a href="/admin/bookings/<%= b._id %>" class="btn <%= b.status === 'pending' ? 'btn-primary' : 'btn-secondary' %> btn-sm">
                    <%= b.status === 'pending' ? 'Review & Decide' : 'View Details' %>
                  </a>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="7" style="text-align: center; padding: var(--space-12);">
                <p style="margin-bottom: var(--space-4); color: var(--text-muted);">No booking requests found matching your filter criteria.</p>
                <a href="/admin/bookings" class="btn btn-secondary btn-sm">Reset all filters</a>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Pagination Footer -->
    <% if (pagination.totalPages > 1) { %>
      <div class="card-footer" style="display: flex; justify-content: space-between; align-items: center; padding: var(--space-4); flex-wrap: wrap; gap: var(--space-3);">
        <span style="font-size: var(--text-xs); color: var(--text-muted);">
          Showing Page <%= pagination.currentPage %> of <%= pagination.totalPages %> (<%= pagination.totalBookings %> total records)
        </span>
        <div style="display: flex; gap: var(--space-2);">
          <% 
            const queryBase = `status=${filters.status}&venue=${filters.venue}&fromDate=${filters.fromDate}&toDate=${filters.toDate}`; 
          %>
          <% if (pagination.hasPrev) { %>
            <a href="/admin/bookings?<%= queryBase %>&page=<%= pagination.prevPage %>" class="btn btn-secondary btn-sm">&larr; Previous</a>
          <% } else { %>
            <button class="btn btn-secondary btn-sm" disabled>&larr; Previous</button>
          <% } %>

          <% if (pagination.hasNext) { %>
            <a href="/admin/bookings?<%= queryBase %>&page=<%= pagination.nextPage %>" class="btn btn-secondary btn-sm">Next &rarr;</a>
          <% } else { %>
            <button class="btn btn-secondary btn-sm" disabled>Next &rarr;</button>
          <% } %>
        </div>
      </div>
    <% } %>
  </div>
</div>
