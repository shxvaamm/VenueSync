<div class="container" style="padding-top: var(--space-8); padding-bottom: var(--space-16);">
  <div style="margin-bottom: var(--space-8);">
    <span class="hero-pill" style="margin-bottom: var(--space-2);">&#9679; Campus Venue Reservation</span>
    <h1 style="margin-bottom: var(--space-2);">Explore &amp; Book Campus Venues</h1>
    <p style="margin: 0; color: var(--text-muted);">
      Filter auditoriums, seminar halls, and grounds by required seating capacity, equipment, and live availability.
    </p>
  </div>

  <!-- Filter Card -->
  <div class="card" style="margin-bottom: var(--space-8); background-color: var(--bg-surface-alt);">
    <div class="card-body">
      <form action="/venues" method="GET">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-4); margin-bottom: var(--space-4);">
          <!-- Minimum Capacity -->
          <div class="form-group" style="margin: 0;">
            <label for="minCapacity" class="form-label">Minimum Capacity</label>
            <input
              type="number"
              id="minCapacity"
              name="minCapacity"
              min="1"
              class="form-input"
              value="<%= filters.minCapacity %>"
              placeholder="e.g. 100"
            >
          </div>

          <!-- Maximum Hourly Rate -->
          <div class="form-group" style="margin: 0;">
            <label for="maxRate" class="form-label">Max Hourly Rate (₹)</label>
            <input
              type="number"
              id="maxRate"
              name="maxRate"
              min="0"
              step="50"
              class="form-input"
              value="<%= filters.maxRate %>"
              placeholder="e.g. 1000"
            >
          </div>

          <!-- Sort Order -->
          <div class="form-group" style="margin: 0;">
            <label for="sort" class="form-label">Sort Venues By</label>
            <select id="sort" name="sort" class="form-select">
              <option value="">Default (Name A-Z)</option>
              <option value="price_asc" <%= filters.sort === 'price_asc' ? 'selected' : '' %>>Price: Low to High</option>
              <option value="price_desc" <%= filters.sort === 'price_desc' ? 'selected' : '' %>>Price: High to Low</option>
              <option value="capacity_asc" <%= filters.sort === 'capacity_asc' ? 'selected' : '' %>>Capacity: Low to High</option>
              <option value="capacity_desc" <%= filters.sort === 'capacity_desc' ? 'selected' : '' %>>Capacity: High to Low</option>
            </select>
          </div>
        </div>

        <!-- Optional Slot Filter -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--space-4); padding-top: var(--space-3); border-top: 1px dashed var(--border-strong); margin-bottom: var(--space-4);">
          <div class="form-group" style="margin: 0;">
            <label for="filterDate" class="form-label">Target Date (IST)</label>
            <input type="date" id="filterDate" name="filterDate" class="form-input" value="<%= filters.filterDate %>">
          </div>
          <div class="form-group" style="margin: 0;">
            <label for="filterStartTime" class="form-label">Start Time</label>
            <input type="time" id="filterStartTime" name="filterStartTime" class="form-input" value="<%= filters.filterStartTime %>">
          </div>
          <div class="form-group" style="margin: 0;">
            <label for="filterEndTime" class="form-label">End Time</label>
            <input type="time" id="filterEndTime" name="filterEndTime" class="form-input" value="<%= filters.filterEndTime %>">
          </div>
        </div>

        <!-- Facilities Filter Checkboxes -->
        <div class="form-group">
          <label class="form-label">Required Facilities (Venues must include ALL selected)</label>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: var(--space-2); margin-top: var(--space-2);">
            <% allFacilities.forEach(function(fac) { %>
              <% const checked = filters.facilities && filters.facilities.includes(fac); %>
              <label style="display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-xs); cursor: pointer;">
                <input
                  type="checkbox"
                  name="facilities"
                  value="<%= fac %>"
                  <%= checked ? 'checked' : '' %>
                >
                <span style="text-transform: capitalize;"><%= fac %></span>
              </label>
            <% }); %>
          </div>
        </div>

        <div style="display: flex; gap: var(--space-3); flex-wrap: wrap;">
          <button type="submit" class="btn btn-primary">Filter venues</button>
          <a href="/venues" class="btn btn-secondary">Reset all filters</a>
        </div>
      </form>
    </div>
  </div>

  <!-- Venues Grid -->
  <% if (venues && venues.length > 0) { %>
    <div class="features-grid">
      <% venues.forEach(function(venue) { %>
        <div class="card card-hoverable" style="display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="height: 160px; background: linear-gradient(135deg, #1e1b4b, #3730a3); color: white; display: flex; align-items: flex-end; padding: var(--space-4);">
              <div>
                <span class="badge" style="background: rgba(255,255,255,0.2); color: white; margin-bottom: var(--space-2);">
                  Capacity: <%= venue.capacity %> Persons
                </span>
                <h3 style="color: white; margin: 0; font-size: var(--text-lg);"><%= venue.name %></h3>
              </div>
            </div>
            
            <div class="card-body">
              <p style="font-size: var(--text-sm); margin-bottom: var(--space-3); line-height: 1.5;">
                <%= venue.description || 'Campus facility equipped for academic presentations, society meets, and workshops.' %>
              </p>
              
              <div style="margin-bottom: var(--space-4);">
                <div style="font-size: var(--text-xs); font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: var(--space-1);">
                  Available Facilities:
                </div>
                <div style="display: flex; gap: 4px; flex-wrap: wrap;">
                  <% if (venue.facilities && venue.facilities.length > 0) { %>
                    <% venue.facilities.forEach(function(fac) { %>
                      <span class="badge" style="background: var(--bg-surface-alt); color: var(--text-main); font-size: 0.7rem; border: 1px solid var(--border-light);">
                        <%= fac %>
                      </span>
                    <% }); %>
                  <% } else { %>
                    <span class="text-xs text-soft">Standard Room Equipment</span>
                  <% } %>
                </div>
              </div>
            </div>
          </div>

          <div class="card-footer" style="display: flex; justify-content: space-between; align-items: center;">
            <div>
              <span style="font-size: var(--text-xs); color: var(--text-muted); display: block;">Hourly Rate</span>
              <strong style="font-size: var(--text-lg); color: var(--primary);">₹<%= venue.hourlyRate %></strong>
              <span style="font-size: var(--text-xs); color: var(--text-soft);"> / hr</span>
            </div>
            <div style="display: flex; gap: var(--space-2);">
              <a href="/venues/<%= venue._id %>" class="btn btn-secondary btn-sm">Details</a>
              <a href="/bookings/new?venue=<%= venue._id %>" class="btn btn-primary btn-sm">Request booking</a>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <!-- Empty State with Clear Filter Loosening Suggestions -->
    <div class="card" style="text-align: center; padding: var(--space-12);">
      <div class="feature-icon" style="margin: 0 auto var(--space-4) auto; background-color: #fef3c7; color: #d97706;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      </div>
      <h2 style="font-size: var(--text-2xl); margin-bottom: var(--space-2);">No Matching Venues Found</h2>
      <p style="max-width: 550px; margin: 0 auto var(--space-6) auto; color: var(--text-muted); font-size: var(--text-sm);">
        No campus facilities matched all of your filter parameters. To find available spaces, consider:
      </p>
      <ul style="list-style: none; padding: 0; max-width: 480px; margin: 0 auto var(--space-6) auto; font-size: var(--text-sm); color: var(--text-main); text-align: left; background: var(--bg-surface-alt); padding: var(--space-4); border-radius: var(--radius-md);">
        <li style="margin-bottom: var(--space-2);">&bull; <strong>Lowering minimum capacity</strong> (currently set to <%= filters.minCapacity || 'None' %>)</li>
        <li style="margin-bottom: var(--space-2);">&bull; <strong>Unchecking specialized equipment</strong> (e.g. live-stream setup, podium) to search broader facilities</li>
        <% if (filters.maxRate) { %>
          <li style="margin-bottom: var(--space-2);">&bull; <strong>Increasing the hourly rate cap</strong> (currently capped at ₹<%= filters.maxRate %>)</li>
        <% } %>
        <% if (filters.filterDate) { %>
          <li>&bull; <strong>Adjusting your requested time slot</strong> to avoid existing reservations or maintenance intervals</li>
        <% } %>
      </ul>
      <a href="/venues" class="btn btn-primary">Clear all filters</a>
    </div>
  <% } %>
</div>
