<div class="container container-sm" style="padding-top: var(--space-8); padding-bottom: var(--space-16);">
  <div style="margin-bottom: var(--space-6);">
    <a href="/venues" class="btn btn-secondary btn-sm">&larr; Back to all venues</a>
  </div>

  <div class="card" style="margin-bottom: var(--space-8);">
    <div style="height: 200px; background: linear-gradient(135deg, #1e1b4b, #4338ca); color: white; display: flex; align-items: flex-end; padding: var(--space-6);">
      <div>
        <span class="badge" style="background: rgba(255,255,255,0.25); color: white; margin-bottom: var(--space-2);">
          Campus Facility
        </span>
        <h1 style="color: white; margin: 0; font-size: var(--text-3xl);"><%= venue.name %></h1>
      </div>
    </div>

    <div class="card-body">
      <!-- Specifications Strip -->
      <div class="stats-grid" style="margin-top: 0; margin-bottom: var(--space-6); padding: var(--space-6);">
        <div class="stat-item">
          <div class="stat-value"><%= venue.capacity %></div>
          <div class="stat-label">Maximum Seating</div>
        </div>
        <div class="stat-item">
          <div class="stat-value">₹<%= venue.hourlyRate %></div>
          <div class="stat-label">Hourly Booking Rate</div>
        </div>
        <div class="stat-item">
          <div class="stat-value"><%= venue.facilities ? venue.facilities.length : 0 %></div>
          <div class="stat-label">Equipped Amenities</div>
        </div>
      </div>

      <!-- Description -->
      <h3 style="font-size: var(--text-lg); margin-bottom: var(--space-2);">Venue Overview</h3>
      <p style="margin-bottom: var(--space-6); font-size: var(--text-base); color: var(--text-main); line-height: 1.6;">
        <%= venue.description || 'This campus venue provides a clean, well-lit environment suited for formal lectures, society events, and workshops.' %>
      </p>

      <!-- Facilities List -->
      <h3 style="font-size: var(--text-lg); margin-bottom: var(--space-3);">Available Facilities &amp; Equipment</h3>
      <div style="display: flex; gap: var(--space-2); flex-wrap: wrap; margin-bottom: var(--space-8);">
        <% if (venue.facilities && venue.facilities.length > 0) { %>
          <% venue.facilities.forEach(function(fac) { %>
            <span class="badge" style="background: var(--primary-50); color: var(--primary-700); border-color: var(--primary-200); font-size: var(--text-sm); padding: 0.4rem 0.8rem;">
              &#10003; <%= fac %>
            </span>
          <% }); %>
        <% } else { %>
          <p class="text-muted text-sm">Standard room amenities only.</p>
        <% } %>
      </div>

      <!-- Upcoming Maintenance Intervals -->
      <h3 style="font-size: var(--text-lg); margin-bottom: var(--space-3);">Scheduled Maintenance Windows</h3>
      <% if (upcomingMaintenance && upcomingMaintenance.length > 0) { %>
        <div class="table-container" style="margin-bottom: var(--space-6);">
          <table class="table">
            <thead>
              <tr>
                <th>Maintenance Window (IST)</th>
                <th>Service Details</th>
              </tr>
            </thead>
            <tbody>
              <% upcomingMaintenance.forEach(function(block) { %>
                <tr>
                  <td>
                    <strong><%= formatISTDateTime(block.from) %></strong>
                    <br>&rarr; <%= formatISTDateTime(block.to) %>
                  </td>
                  <td><%= block.reason || 'General campus upkeep' %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p style="font-size: var(--text-sm); color: var(--text-muted); margin-bottom: var(--space-6);">
          No upcoming maintenance blocks scheduled. All operational slots (08:00 &ndash; 22:00 IST) are available for booking requests.
        </p>
      <% } %>

      <a href="/bookings/new?venue=<%= venue._id %>" class="btn btn-primary btn-block btn-lg">
        Request booking for this venue
      </a>
    </div>
  </div>
</div>
