<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="ie=edge">
  <meta name="description" content="Campus and Community Event & Venue Booking Management System. Reserve auditoriums, seminar halls, labs, and open grounds seamlessly.">
  <title><%= typeof title !== 'undefined' ? title + ' | VenueSync' : 'VenueSync - Event & Venue Booking Management System' %></title>
  
  <!-- Google Fonts: Space Grotesk & Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
  
  <!-- Design System CSS -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <!-- Accessible Skip Link -->
  <a href="#main-content" class="skip-link">Skip to main content</a>

  <!-- Role-aware Header Navigation -->
  <%- include('../partials/header') %>

  <!-- Flash Notification Messages -->
  <div class="container">
    <%- include('../partials/flash') %>
  </div>

  <!-- Main Content Insertion -->
  <main id="main-content">
    <%- body %>
  </main>

  <!-- Site Footer -->
  <%- include('../partials/footer') %>

  <!-- Optional Vanilla JS -->
  <script src="/js/main.js" defer></script>
</body>
</html>
