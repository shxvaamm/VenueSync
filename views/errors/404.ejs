<section class="container error-hero">
  <div class="error-code">404</div>
  <h1 class="error-title">Requested Page Not Found</h1>
  <p class="error-description">
    The URL you tried to reach does not exist or may have been relocated. Check the address bar for typos, or return to the main dashboard to continue navigating.
  </p>
  <div style="display: flex; gap: var(--space-3); justify-content: center; flex-wrap: wrap;">
    <a href="/" class="btn btn-primary">Return to home</a>
    <a href="javascript:history.back()" class="btn btn-secondary">Go back</a>
  </div>
</section>
